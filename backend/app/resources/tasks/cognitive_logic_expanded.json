    "2": {
      "name": "Cause and Effect",
      "name_zh": "因果关系",
      "task_type": "cause_effect",
      "tasks": [
        {
          "instruction": "What happens if you drop a glass?",
          "instruction_zh": "如果你摔了一个杯子会怎样？",
          "cause": "Drop a glass",
          "cause_zh": "摔杯子",
          "correct_effect": "It breaks",
          "correct_effect_zh": "它会碎",
          "options": ["It breaks", "It flies", "It grows"],
          "options_zh": ["它会碎", "它会飞", "它会长大"]
        },
        {
          "instruction": "What happens when it rains?",
          "instruction_zh": "下雨时会怎样？",
          "cause": "It rains",
          "cause_zh": "下雨",
          "correct_effect": "The ground gets wet",
          "correct_effect_zh": "地面变湿",
          "options": ["The ground gets wet", "It snows", "The sun comes out"],
          "options_zh": ["地面变湿", "下雪了", "太阳出来了"]
        },
        {
          "instruction": "What happens if you water a plant?",
          "instruction_zh": "如果你浇花会怎样？",
          "cause": "Water a plant",
          "cause_zh": "浇花",
          "correct_effect": "It grows",
          "correct_effect_zh": "它会长大",
          "options": ["It grows", "It flies away", "It turns blue"],
          "options_zh": ["它会长大", "它飞走了", "它变蓝了"]
        },
        {
          "instruction": "What happens if you turn off the light?",
          "instruction_zh": "如果你关灯会怎样？",
          "cause": "Turn off the light",
          "cause_zh": "关灯",
          "correct_effect": "It gets dark",
          "correct_effect_zh": "变暗了",
          "options": ["It gets dark", "It gets hot", "It rains"],
          "options_zh": ["变暗了", "变热了", "下雨了"]
        },
        {
          "instruction": "What happens if you put ice in the sun?",
          "instruction_zh": "如果你把冰放在太阳下会怎样？",
          "cause": "Ice in the sun",
          "cause_zh": "冰在太阳下",
          "correct_effect": "It melts",
          "correct_effect_zh": "它会融化",
          "options": ["It melts", "It freezes more", "It turns red"],
          "options_zh": ["它会融化", "它结更多冰", "它变红了"]
        },
        {
          "instruction": "What happens when you blow a balloon too much?",
          "instruction_zh": "如果你把气球吹太大会怎样？",
          "cause": "Over-inflate balloon",
          "cause_zh": "吹太大气球",
          "correct_effect": "It pops",
          "correct_effect_zh": "它会爆",
          "options": ["It pops", "It shrinks", "It flies to space"],
          "options_zh": ["它会爆", "它缩小了", "它飞到太空"]
        },
        {
          "instruction": "What happens if you don't eat?",
          "instruction_zh": "如果你不吃饭会怎样？",
          "cause": "Don't eat",
          "cause_zh": "不吃饭",
          "correct_effect": "You get hungry",
          "correct_effect_zh": "你会饿",
          "options": ["You get hungry", "You get taller", "You turn green"],
          "options_zh": ["你会饿", "你变高了", "你变绿了"]
        },
        {
          "instruction": "What happens if you push a ball?",
          "instruction_zh": "如果你推一个球会怎样？",
          "cause": "Push a ball",
          "cause_zh": "推球",
          "correct_effect": "It rolls",
          "correct_effect_zh": "它会滚",
          "options": ["It rolls", "It jumps", "It disappears"],
          "options_zh": ["它会滚", "它会跳", "它消失了"]
        }
      ]
