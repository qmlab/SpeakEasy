    "4": {
      "name": "Reasoning",
      "name_zh": "推理",
      "task_type": "reason",
      "tasks": [
        {
          "instruction": "If all dogs have four legs, and Max is a dog, how many legs does Max have?",
          "instruction_zh": "如果所有的狗都有四条腿，而Max是一只狗，Max有几条腿？",
          "logic_type": "deductive",
          "correct_answer": "Four",
          "correct_answer_zh": "四条",
          "options": ["Two", "Four", "Six"]
        },
        {
          "instruction": "If it's bigger than a cat but smaller than a horse, what could it be?",
          "instruction_zh": "如果它比猫大但比马小，它可能是什么？",
          "logic_type": "size_comparison",
          "correct_answer": "Dog",
          "correct_answer_zh": "狗",
          "options": ["Mouse", "Dog", "Elephant"]
        },
        {
          "instruction": "If you mix red and yellow, what color do you get?",
          "instruction_zh": "如果你把红色和黄色混在一起，会变成什么颜色？",
          "logic_type": "color_mixing",
          "correct_answer": "Orange",
          "correct_answer_zh": "橙色",
          "options": ["Green", "Orange", "Purple"]
        },
        {
          "instruction": "Monday, Tuesday, Wednesday... What comes next?",
          "instruction_zh": "星期一、星期二、星期三...接下来是什么？",
          "logic_type": "sequence",
          "correct_answer": "Thursday",
          "correct_answer_zh": "星期四",
          "options": ["Friday", "Thursday", "Sunday"]
        },
        {
          "instruction": "If Sara is taller than Tom, and Tom is taller than Bob, who is the tallest?",
          "instruction_zh": "如果小红比小明高，小明比小华高，谁最高？",
          "logic_type": "transitive",
          "correct_answer": "Sara",
          "correct_answer_zh": "小红",
          "options": ["Sara", "Tom", "Bob"]
        },
        {
          "instruction": "A circle has 0 corners. A triangle has 3 corners. How many corners does a square have?",
          "instruction_zh": "圆有0个角。三角形有3个角。正方形有几个角？",
          "logic_type": "counting",
          "correct_answer": "4",
          "correct_answer_zh": "4个",
          "options": ["3", "4", "5"]
        },
        {
          "instruction": "If you have 3 apples and eat 1, how many are left?",
          "instruction_zh": "如果你有3个苹果，吃了1个，还剩几个？",
          "logic_type": "subtraction",
          "correct_answer": "2",
          "correct_answer_zh": "2个",
          "options": ["1", "2", "4"]
        },
        {
          "instruction": "Spring, Summer, Autumn... What comes next?",
          "instruction_zh": "春天、夏天、秋天...接下来是什么？",
          "logic_type": "sequence",
          "correct_answer": "Winter",
          "correct_answer_zh": "冬天",
          "options": ["Spring", "Winter", "Summer"]
        }
